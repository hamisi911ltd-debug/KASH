{
  "name": "kash-web",
  "main": "worker.js",
  "compatibility_date": "2026-11-03",
  "routes": [
    { "pattern": "kashgeneralsuppliers.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
