# Security headers for Cloudflare Pages / Netlify (served with every page).
#
# The two 'sha256-...' entries allow exactly the two small inline <script>
# blocks in index.html (theme-before-paint and the splash backstop) and nothing
# else. If you edit either script, the hashes must change: the test
# `npm test` (headers.test.js) fails and prints the new values.
#
# connect-src lists where the app may send data. *.workers.dev covers the
# demo and live APIs; replace it with your own API domain once you have one.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-DC8kE26eBXktbjMnV5RwrFO6yiMSNE5Kx97R37GB3MY=' 'sha256-Cb79Ue6OJjzhbHdGsN/518zZ4MT/rlpnkMepo6T6T/0=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self' https://*.workers.dev; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
